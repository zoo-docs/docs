{
  "name": "zoo-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Zoo Network Documentation",
  "scripts": {
    "css": "hanzo-docs-css app/gui.css",
    "predev": "pnpm css",
    "dev": "next dev --webpack",
    "prebuild": "pnpm css",
    "build": "docs-mdx && next build --webpack",
    "clean": "rimraf .next out docs app/gui.css",
    "lint": "docs-mdx && next lint",
    "start": "next start",
    "types:check": "docs-mdx && tsc --noEmit"
  },
  "dependencies": {
    "@hanzo/design": "^0.5.25",
    "@hanzo/docs": "^17.0.4",
    "@hanzo/docs-core": "^17.0.1",
    "@hanzo/docs-mdx": "^15.0.10",
    "@hanzo/docs-ui": "^17.0.5",
    "@hanzo/gui": "^8.3.1",
    "@hanzo/ui": "^8.27.7",
    "@hanzogui/lucide-icons-2": "^8.1.1",
    "esbuild": "^0.25.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native-web": "^0.21.2",
    "shiki": "^3.20.0"
  },
  "devDependencies": {
    "@hanzogui/config": "^8.1.1",
    "@hanzogui/web": "^8.1.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "rimraf": "^6.1.3",
    "typescript": "7.0.2"
  }
